```bash
PERCALL_PROBE=1 PROBE_START_STEP=170 PROBE_END_STEP=250 \
    torchrun --nproc_per_node=32 --nnodes=7 \
    --rdzv_backend=c10d --rdzv_endpoint=$MASTER:29500 \
